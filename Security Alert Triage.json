        "jsCode": "const alerts = [\n  { source: \"EDR\", subject: \"Ransomware behaviour detected\", body: \"Host FIN-LAPTOP-07 is mass-encrypting files in /Shares/Finance. Process: svchost32.exe (unsigned).\" },\n  { source: \"IAM\", subject: \"Impossible travel login\", body: \"User j.meyer logged in from Berlin at 09:02 and from Lagos at 09:14. MFA was approved both times.\" },\n  { source: \"WAF\", subject: \"SQL injection attempts blocked\", body: \"312 blocked requests with UNION SELECT payloads against /api/orders from one IP in 10 minutes.\" },\n  { source: \"SIEM\", subject: \"Multiple failed logins\", body: \"7 failed logins for user intern01 on the VPN, followed by a successful login.\" },\n  { source: \"Vuln scanner\", subject: \"Outdated TLS version\", body: \"Internal wiki server still accepts TLS 1.0. No external exposure.\" },\n  { source: \"Email gateway\", subject: \"Newsletter flagged as spam\", body: \"Marketing newsletter from a known vendor was quarantined as bulk mail.\" }\n];\nreturn alerts.map(a => ({ json: a }));"
      },
