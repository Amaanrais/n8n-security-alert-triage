        "inputText": "=Source: {{ $json.source }}. Subject: {{ $json.subject }}. Details: {{ $json.body }}",
        "categories": {
          "categories": [
            {
              "category": "Critical ",
              "description": "Active compromise or ongoing damage, such as ransomware, data exfiltration or a confirmed account takeover. Needs immediate response."
            },
            {
              "category": "High",
              "description": "Signs the attacker may have succeeded or gained access, e.g. a successful login after many failures, or impossible-travel logins. NOT for attacks that were fully blocked."
            },
            {
              "category": "Medium",
              "description": "Attack attempts that were blocked or failed with no sign of success (e.g. blocked WAF or SQL injection attempts), or an exploitable vulnerability. Not for routine spam or bulk mail."
            },
            {
              "category": "Low",
              "description": "No real threat: routine spam or bulk/marketing email, false positives, traffic from known vendors, or minor hygiene issues on internal-only systems with no external exposure."
            }
          ]
        },
